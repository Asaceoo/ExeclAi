<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)'=='x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)'=='x86'">win-x86</RuntimeIdentifier>
    <!-- 2026-09-12 改名绕开 Defender 对旧哈希的误报隔离（ex原名含 COM 强杀+剪贴板特征） -->
    <AssemblyName>XaiProbe</AssemblyName>
    <RootNamespace>SlicerProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ExcelAiAssistant.Core\ExcelAiAssistant.Core.csproj" />
    <ProjectReference Include="..\..\src\ExcelAiAssistant.Excel\ExcelAiAssistant.Excel.csproj" />
    <ProjectReference Include="..\..\src\ExcelAiAssistant.Addin\ExcelAiAssistant.Addin.csproj" />
  </ItemGroup>
</Project>
